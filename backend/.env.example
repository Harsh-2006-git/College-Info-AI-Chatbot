# Google Gemini API Key(s) (supports comma-separated list for auto-rotation)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key(s) (supports comma-separated list for auto-rotation)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ChromaDB persistent storage path
CHROMA_DB_PATH=./vectorstore

# Directory where uploaded PDFs are stored
UPLOAD_DIR=./uploads

# Max upload file size in bytes (20 MB)
MAX_FILE_SIZE=20971520

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,https://college-info-ai-chatbot.vercel.app
